# Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce_ops_brain
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/ecommerce_ops_brain

# LLM — EPAM DIAL proxy
EPAM_DIAL_API_KEY=dial-...
EPAM_DIAL_ENDPOINT=https://ai-proxy.lab.epam.com
EPAM_DIAL_DEPLOYMENT=gemini-2.5-flash
EPAM_DIAL_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EPAM_DIAL_API_VERSION=2023-12-01-preview
LLM_TEMPERATURE=0.1

# MCP Servers
MCP_METRICS_HOST=localhost
MCP_METRICS_PORT=5010
MCP_INVENTORY_HOST=localhost
MCP_INVENTORY_PORT=5011
MCP_MARKETING_HOST=localhost
MCP_MARKETING_PORT=5012
MCP_SUPPORT_HOST=localhost
MCP_SUPPORT_PORT=5013
MCP_POSTGRES_HOST=localhost
MCP_POSTGRES_PORT=5014

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8001
CORS_ORIGINS=http://localhost:5173

# Data Generation
DATA_GEN_SEED=42
DATA_GEN_START_DATE=2026-02-01
DATA_GEN_END_DATE=2026-04-06

# Scheduled Monitoring
MONITOR_INTERVAL_MINUTES=30

# Langfuse (Observability & Evaluation)
# Self-hosted: run via Docker, or use cloud at https://cloud.langfuse.com
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=http://localhost:3000   # change to https://cloud.langfuse.com for cloud
